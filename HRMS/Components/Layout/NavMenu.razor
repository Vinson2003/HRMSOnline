@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">HRMS</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler')?.dispatchEvent(new MouseEvent('click', { bubbles: true }))">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="department">
                <span class="bi bi-building-fill" aria-hidden="true"></span> Department
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="employee">
                <span class="bi bi-person-vcard" aria-hidden="true"></span> Employee
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="leavetype">
                <span class="bi bi-calendar2-week" aria-hidden="true"></span> Leave Type
            </NavLink>
        </div>

        <AuthorizeView Roles="Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="user">
                    <span class="bi bi-person-circle" aria-hidden="true"></span> User
                </NavLink>
            </div>
        </AuthorizeView>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="role">
                <span class="bi bi-shield-lock" aria-hidden="true"></span> Role
            </NavLink>
        </div>
    </nav>
</div>

