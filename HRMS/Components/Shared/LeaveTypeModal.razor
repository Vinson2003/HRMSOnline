@using HRMS.Service.Base
@using HRMS.Service.Interface
@using HRMS.Service.Models
@inject ILeaveTypeService LeaveTypeService

@if (IsVisible)
{
    <!-- Backdrop div creates the dark background overlay behind the Bootstrap modal -->
    <div class="modal-backdrop fade show"></div>
}

<div class="modal fade @(IsVisible ? "show d-block" : "")" tabindex="1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">@modalTitle</h5>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mb-3">@errorMessage</div>
                }

                <div class="mb-3">
                    <label class="form-label fw-bold">Type Name</label>
                    <input type="text" class="form-control" maxlength="50" @bind="typeName" />
                </div>
                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="requiresAttachment" @bind="requiresAttachment" />
                        <label class="form-check-label" for="requiresAttachment">Requires attachment</label>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="SubmitFormAsync">Save</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnSaveSuccess { get; set; }

    private bool IsVisible;
    private string errorMessage = string.Empty;
    private string modalTitle = "Add Leave Type";

    private int currentId;
    private string typeName = string.Empty;
    private bool requiresAttachment;

    public void CloseModal()
    {
        IsVisible = false;
        StateHasChanged();
    }

    // leaveType == null -> Add, otherwise Edit
    public Task ShowAsync(LeaveTypeList? data = null)
    {
        currentId = data?.Id ?? 0;
        typeName = data?.TypeName ?? string.Empty;
        requiresAttachment = data?.RequiresAttachment ?? false;

        modalTitle = data is null ? "Add Leave Type" : "Edit Leave Type";
        errorMessage = string.Empty;
        IsVisible = true;

        // Notify the component to re-render and display the modal
        StateHasChanged();

        return Task.CompletedTask;
    }

    // Validate and submit the form data to the service
    private async Task SubmitFormAsync()
    {
        if (string.IsNullOrWhiteSpace(typeName))
        {
            errorMessage = "Type name is required.";
            return;
        }

        // Call the appropriate service method based on whether we are adding or editing an leave type
        var response = currentId == 0
            ? await LeaveTypeService.CreateLeaveTypeAsync(new CreateLeaveType
            {
                TypeName = typeName,
                RequiresAttachment = requiresAttachment,
            })
            : await LeaveTypeService.UpdateLeaveTypeAsync(new UpdateLeaveType
            {
                Id = currentId,
                TypeName = typeName,
                RequiresAttachment = requiresAttachment,
            });

        if (!response.Result)
        {
            errorMessage = response.Message ?? "Failed to save leave type.";
            return;
        }

        IsVisible = false;
        // InvokeAsync: Notify the parent component that the save operation was successful
        await OnSaveSuccess.InvokeAsync();
    }
}