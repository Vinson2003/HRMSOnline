@page "/department"
@using HRMS.Components.Shared
@using HRMS.LIB
@using HRMS.Service.Base
@using HRMS.Service.Models
@using HRMS.Service.Interface
@rendermode InteractiveServer
@inject IDepartmentService DepartmentService
@inject IJSRuntime JS

<PageTitle>Department Page</PageTitle>

<div class="mt-2">
    <h4>Master Department</h4>

    <!-- Gunakan d-flex dan justify-content-between untuk memisahkan posisi kiri dan kanan -->
    <div class="d-flex justify-content-between align-items-center mb-3 mt-2">
        <!-- Kotak Pencarian di sebelah kiri -->
        <div class="w-25">
            <input type="text" class="form-control" placeholder="Search Department..."
                   @bind="searchName" @bind:event="oninput" @onkeyup="LoadData" />
        </div>

        <!-- CRUCIAL: Clicking this button invokes the Show() method of the child modal -->
        <div>
            <button class="btn btn-primary" @onclick="OpenAddModal">Add department</button>
        </div>
    </div>

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>No</th>
                <th>Department Name</th>
                <th class="text-center w-25">Action</th>
            </tr>
        </thead>
        <tbody>
            @* CRUCIAL: Always check for null or empty collections before iterating to prevent NullReferenceException rendering errors. *@
            @if (departmentList != null && departmentList.Any())
            {
                @* CRUCIAL: The @foreach loop dynamically generates HTML rows based on the C# collection. *@
                @foreach (var dept in departmentList)
                {
                    <tr>
                        <td>@dept.Id</td>
                        <td>@dept.DepartmentName</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-warning me-2" @onclick="() => OpenEditModal(dept.Id, dept.DepartmentName)">Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteDepartment(dept.Id, dept.DepartmentName)">Delete</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">Data not found....</td>
                </tr>
            }
        </tbody>
    </table>
    <!-- Navigasi Paginasi Bootstrap -->
    <div class="d-flex justify-content-between align-items-center mt-3">
        <div>
            Menampilkan data @(TotalData == 0 ? 0 : paging.Start + 1) hingga @Math.Min(paging.Start + paging.Length, TotalData) dari total @TotalData departemen.
        </div>
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="PreviousPage">Previous</button>
                </li>

                @for (int i = 1; i <= TotalPages; i++)
                {
                    int pageNumber = i;
                    <li class="page-item @(CurrentPage == pageNumber ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                    </li>
                }

                <li class="page-item @(CurrentPage >= TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="NextPage">Next</button>
                </li>
            </ul>
        </nav>
    </div>
</div>

<DepartmentModal @ref="modalRef" OnSaveSuccess="LoadData" />

@code {
    #region 1. Component References
    // CRUCIAL: @ref binds this variable directly to the child modal component instance
    private DepartmentModal modalRef = null!;
    #endregion

    #region 2. State & Properties
    private List<DepartmentList> departmentList = new();
    private string searchName = string.Empty;
    private BasePaging paging = new BasePaging { Start = 0, Length = 10, Column = "Id", SortBy = Const.PAGING_SORT_ASC };

    // Variabel state untuk melacak total data dari database
    private int TotalData = 0;
    #endregion

    #region 3. Computed Properties (Pagination)
    // CRUCIAL: Calculate TotalPages dynamically based on TotalData and page Length
    private int TotalPages => (int)Math.Ceiling((double)TotalData / paging.Length);

    // CRUCIAL: Calculate current active page index (1-based)
    private int CurrentPage => (paging.Start / paging.Length) + 1;
    #endregion

    #region 4. Lifecycle Methods
    // CRUCIAL: Blazor lifecycle method. OnInitialized is called when the component is first created and ready to fetch data.
    protected override void OnInitialized()
    {
        LoadData();
    }
    #endregion

    #region 5. Core Data Methods
    private void LoadData()
    {
        var response = DepartmentService.GetAllDepartments(paging, searchName);
        if (response != null && response.Result != null)
        {
            departmentList = response.Result;

            // CRUCIAL: Tangkap total baris keseluruhan dari respons backend
            TotalData = response.Total;
        }
    }
    #endregion

    #region 6. CRUD UI Actions
    private void OpenAddModal()
    {
        modalRef.Show();
    }

    private void OpenEditModal(int id, string? name)
    {
        // CRUCIAL: Pass the specific department data to the modal for editing
        modalRef.Show(id, name ?? "");
    }

    private async Task DeleteDepartment(int id, string? name)
    {
        bool isConfirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete department '{name}'?");

        if (isConfirmed)
        {
            var response = DepartmentService.DeleteDepartment(id);

            if (response.Result)
            {
                // 1. Tarik ulang data bersih dari SQL Server
                LoadData();
                // 2. Paksa tabel UI untuk di-render ulang seketika
                StateHasChanged();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", response.Message);
            }
        }
    }
    #endregion

    #region 7. Pagination Navigation
    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            paging.Start -= paging.Length;
            LoadData();
        }
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            paging.Start += paging.Length;
            LoadData();
        }
    }

    private void GoToPage(int pageNumber)
    {
        // Diperbaiki: (pageNumber - 1)
        paging.Start = (pageNumber - 1) * paging.Length;
        LoadData();
    }
    #endregion
}