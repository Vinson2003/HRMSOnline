@page "/department"
@using HRMS.Components.Shared
@using HRMS.LIB
@using HRMS.Service.Base
@using HRMS.Service.Models
@using HRMS.Service.Interface
@rendermode InteractiveServer
@inject IDepartmentService DepartmentService
@inject IJSRuntime JS

<PageTitle>Department Page</PageTitle>

<div class="mt-2">
    <h4>Master Department</h4>

    <!-- Gunakan d-flex dan justify-content-between untuk memisahkan posisi kiri dan kanan -->
    <div class="d-flex justify-content-between align-items-center mb-3 mt-2">
        <!-- Kotak Pencarian di sebelah kiri -->
        <div class="w-25">
            <input type="text" class="form-control" placeholder="Search Department..."
                @bind="searchName" @bind:event="oninput" @onkeyup="LoadDataAsync" />
        </div>

        <!-- Clicking this button invokes the Show() method of the child modal -->
        <div>
            <button class="btn btn-primary" @onclick="OpenAddModal">Add Department</button>
        </div>
    </div>

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>No</th>
                <th>Department Name</th>
                <th class="text-center w-25">Action</th>
            </tr>
        </thead>
        <tbody>
            @* Always check for null or empty collections before iterating to prevent NullReferenceException rendering errors. *@
            @if (departmentList != null && departmentList.Any())
            {
                @* The @foreach loop dynamically generates HTML rows based on the C# collection. *@
                @foreach (var dept in departmentList)
                {
                    <tr>
                        <td>@dept.Id</td>
                        <td>@dept.DepartmentName</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-warning me-2" @onclick="() => OpenEditModal(dept.Id, dept.DepartmentName)">Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteDepartmentAsync(dept.Id, dept.DepartmentName)">Delete</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">Data not found....</td>
                </tr>
            }
        </tbody>
    </table>
    <!-- Navigasi Pagination Bootstrap -->
    <div class="d-flex justify-content-between align-items-center mt-3">
        <div>
            Menampilkan data @(TotalData == 0 ? 0 : paging.Start + 1) hingga @Math.Min(paging.Start + paging.Length, TotalData) dari total @TotalData departemen.
        </div>
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="PreviousPageAsync">Previous</button>
                </li>

                @for (int i = 1; i <= TotalPages; i++)
                {
                    int pageNumber = i;
                    <li class="page-item @(CurrentPage == pageNumber ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPageAsync(pageNumber)">@pageNumber</button>
                    </li>
                }

                <li class="page-item @(CurrentPage >= TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="NextPageAsync">Next</button>
                </li>
            </ul>
        </nav>
    </div>
</div>

<DepartmentModal @ref="modalRef" OnSaveSuccess="LoadDataAsync" />

@code {
    // @ref binds this variable directly to the child modal component instance
    private DepartmentModal modalRef = null!;

    private List<DepartmentList> departmentList = new();
    private string searchName = string.Empty;
    private BasePaging paging = new BasePaging { Start = 0, Length = 10, Column = "Id", SortBy = Const.PAGING_SORT_ASC };

    private int TotalData = 0;

    // Calculate TotalPages dynamically based on TotalData and page Length
    private int TotalPages => (int)Math.Ceiling((double)TotalData / paging.Length);

    // Calculate current active page index (1-based)
    private int CurrentPage => (paging.Start / paging.Length) + 1;

    // Blazor lifecycle method. OnInitialized is called when the component is first created and ready to fetch data.
    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var response = await DepartmentService.GetAllDepartmentsAsync(paging, searchName);

        departmentList = response.Result ?? [];
        TotalData = response.Total;
    }

    private void OpenAddModal()
    {
        modalRef.Show();
    }

    private void OpenEditModal(int id, string? name)
    {
        modalRef.Show(id, name ?? "");
    }

    private async Task DeleteDepartmentAsync(int id, string? name)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm", $"Are you sure you want to delete department '{name}'?");

        if (!confirmed)
        {
            return;
        }

        var response = await DepartmentService.DeleteDepartmentAsync(id);

        if (response.Result)
        {
            await LoadDataAsync();
            return;
        }

        await JS.InvokeVoidAsync("alert", response.Message);
    }

    private async Task PreviousPageAsync()
    {
        if (CurrentPage <= 1)
        {
            return;
        }

        paging.Start -= paging.Length;
        await LoadDataAsync();
    }

    private async Task NextPageAsync()
    {
        if (CurrentPage >= TotalPages)
        {
            return;
        }

        paging.Start += paging.Length;
        await LoadDataAsync();
    }

    private async Task GoToPageAsync(int pageNumber)
    {
        paging.Start = (pageNumber - 1) * paging.Length;
        await LoadDataAsync();
    }
}