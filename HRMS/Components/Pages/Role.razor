@page "/role"
@using HRMS.LIB
@using HRMS.Service.Base
@using HRMS.Service.Models
@using HRMS.Service.Interface
@using HRMS.Components.Shared
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@inject IRoleService RoleService
@inject IJSRuntime JS
@attribute [Authorize]

<PageTitle>Role Page</PageTitle>

<div class="mt-2">
    <h4>Role Management</h4>

    <div class="d-flex justify-content-end mb-3 mt-2">
        <div>
            <button class="btn btn-primary" @onclick="OpenAddModal">Add Role</button>
        </div>
    </div>

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>RoleName</th>
                <th>Created</th>
                <th class="text-center w-25">Action</th>
            </tr>
        </thead>
        <tbody>
            @* Always check for null or empty collections before iterating to prevent NullReferenceException rendering errors. *@
            @if (roleList != null && roleList.Any())
            {
                @* The @foreach loop dynamically generates HTML rows based on the C# collection. *@
                @foreach (var role in roleList)
                {
                    <tr>
                        <td>@role.RoleName</td>
                        <td>@role.Created</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-warning me-2" @onclick="() => EditRoleModal(role.Id, role.RoleName)">Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteRoleAsync(role.Id, role.RoleName)">Delete</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">Data not found....</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex justify-content-between align-items-center mt-3">
        <div>
            Showing data @(TotalData == 0 ? 0 : paging.Start + 1) to @Math.Min(paging.Start + paging.Length, TotalData) out of a total of @TotalData roles.
        </div>
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="PreviousPageAsync">Previous</button>
                </li>

                @for (int i = 1; i <= TotalPages; i++)
                {
                    int pageNumber = i;
                    <li class="page-item @(CurrentPage == pageNumber ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPageAsync(pageNumber)">@pageNumber</button>
                    </li>
                }

                <li class="page-item @(CurrentPage >= TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="NextPageAsync">Next</button>
                </li>
            </ul>
        </nav>
    </div>
</div>

<RoleModal @ref="modalRef" OnSaveSuccess="LoadDataAsync" />

@code {
    // @ref binds this variable directly to the child modal component instance
    private RoleModal modalRef = null!;

    private List<RoleList> roleList = new();
    private BasePaging paging = new BasePaging { Start = 0, Length = 10, Column = "Id", SortBy = Const.PAGING_SORT_ASC };

    private int TotalData = 0;

    private int TotalPages => (int)Math.Ceiling((double)TotalData / paging.Length);

    private int CurrentPage => (paging.Start / paging.Length) + 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var response = await RoleService.RoleListAsync(paging);

        roleList = response.Result ?? [];
        TotalData = response.Total;
    }

    private void OpenAddModal()
    {
        modalRef.Show();
    }

    private void EditRoleModal(int id, string? name)
    {
        modalRef.Show(id, name ?? "");
    }

    private async Task DeleteRoleAsync(int id, string? name)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure want to delete this role '{name}'?");

        if (!confirmed)
        {
            return;
        }

        var response = await RoleService.DeleteRoleAsync(id);

        if (response.Result)
        {
            await LoadDataAsync();
            return;
        }

        await JS.InvokeVoidAsync("alert", response.Message);
    }

    private async Task PreviousPageAsync()
    {
        if (CurrentPage <= 1)
        {
            return;
        }

        paging.Start -= paging.Length;
        await LoadDataAsync();
    }

    private async Task NextPageAsync()
    {
        if (CurrentPage >= TotalPages)
        {
            return;
        }

        paging.Start += paging.Length;
        await LoadDataAsync();
    }

    private async Task GoToPageAsync(int pageNumber)
    {
        paging.Start = (pageNumber - 1) * paging.Length;
        await LoadDataAsync();
    }
}